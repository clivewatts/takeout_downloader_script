# Web interface settings (all optional)

# Where archives are written. Docker uses /downloads; local runs default to ./downloads.
# OUTPUT_DIR=./downloads

# Concurrent downloads (1-20).
# PARALLEL_DOWNLOADS=6

# Maximum number of archive parts to look for.
# FILE_COUNT=100

# Flask session secret. A random value is generated at startup when unset,
# which is fine for a single-process deployment behind no proxy.
# SECRET_KEY=change-me

# Comma-separated origins allowed to open a Socket.IO connection.
# Defaults to same-origin when unset. Set to * only behind a trusted proxy.
# CORS_ALLOWED_ORIGINS=http://localhost:5000
